# ============================================================
# Kodara — ornek ortam degiskenleri
# Bu dosyayi .env.local olarak kopyalayip degerleri doldur.
# Vercel'e deploy ederken ayni degiskenleri
# Settings > Environment Variables altina da eklemen gerekir.
# ============================================================

# --- AI asistani (/api/bot) -------------------------------
# https://console.groq.com/keys
# Bos birakilirsa sohbet baloncugu "asistan devre disi" mesaji gosterir.
GROQ_API_KEY=""

# Kullanilacak model. Bos birakilirsa openai/gpt-oss-120b kullanilir.
# Groq zaman zaman model emekli ediyor; bot "ulasilamiyor" derse
# https://console.groq.com/docs/models listesinden guncel bir id yaz.
GROQ_MODEL=""

# --- Lead e-posta bildirimi (/api/lead + chatbot araci) ----
# https://resend.com > API Keys
# Bos birakilirsa lead kaybolmaz, sunucu loguna yazilir.
RESEND_API_KEY=""

# Lead bildirimlerinin dusecegi adres
LEAD_TO_EMAIL="sametaratoglu@gmail.com"

# Gonderen. Kendi domainini Resend'de dogrulayana kadar test adresi kullan
# (test adresi yalnizca kendi Resend hesap e-postana gonderebilir).
LEAD_FROM_EMAIL="Kodara <onboarding@resend.dev>"

# --- Site ------------------------------------------------
# Kanonik adres; sitemap ve OG etiketlerini besler.
# Bos birakilirsa Vercel production domaini, o da yoksa localhost kullanilir.
NEXT_PUBLIC_SITE_URL=""

# --- Reklam donusum takibi (opsiyonel) --------------------
# Bos birakilirsa hicbir takip scripti yuklenmez.
# Meta Events Manager > Veri Kaynaklari > Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=""
# Google Ads > Araclar > Donusumler  (AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=""
# Ayni ekrandaki donusum etiketi
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=""
