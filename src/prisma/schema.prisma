// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  META_ADS
  CHATBOT
  FORM
  WHATSAPP
}

model Lead {
  id        String     @id @default(cuid())
  fullName  String
  email     String?
  phone     String?
  company   String?
  service   String
  status    LeadStatus @default(NEW)
  source    LeadSource @default(META_ADS)
  value     Float?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}